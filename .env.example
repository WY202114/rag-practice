# 复制为 .env，在项目根目录启动服务；文件使用 UTF-8 编码。
# 本文件只包含 app/config.py 当前实际读取的配置项。

APP_NAME=rag-practice

# 智谱 API：向量化和聊天共用此密钥。请填写自己的密钥。
ZHIPU_API_KEY=replace_with_your_zhipu_api_key

# 当前 get_embeddings() 仅实现 zhipu；local/openai 分支仍是注释。
EMBEDDING_PROVIDER=zhipu
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_MODEL=embedding-3

# 模型名沿用项目现有配置，请确认自己的账号有调用权限。
CHAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
CHAT_MODEL=glm-5.3-flash

# 必须替换下面的公开占位值，长度至少 64 个字符。
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_this_public_example_with_64_or_more_random_characters_before_use
JWT_EXPIRE_MINUTES=30

# 可选：LangSmith 请求追踪，默认关闭。
# 开启后可能上传问题、参考资料和回答；确认资料适合上传后再启用。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-practice
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
